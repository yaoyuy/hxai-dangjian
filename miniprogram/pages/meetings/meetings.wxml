<view class="page">
  <view class="crumb">组织生活 › <text>三会一课</text></view>
  <view class="page-title">三会一课</view>
  <view class="page-sub">支委会、党员大会、党小组会与党课安排（后端 kind=meeting 的活动）。</view>

  <view class="loading" wx:if="{{loading}}">正在加载…</view>
  <view class="empty" wx:elif="{{errMsg}}">{{errMsg}}</view>

  <block wx:else>
    <view class="sec-head">
      <text class="sec-title">会议与党课</text>
      <text class="sec-extra">共 {{list.length}} 场</text>
    </view>

    <view class="acard" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="acard-body">
        <view class="acard-title">{{item.title}}</view>
        <view class="acard-sum">{{item.summary}}</view>
        <view class="acard-meta" style="flex-wrap:wrap">
          <text class="tag">{{item.kindText}}</text>
          <text class="chip-status {{item.status === 'open' ? 'done' : 'todo'}}">{{item.statusText}}</text>
          <text class="demo-tag" wx:if="{{item.is_demo}}">测试数据</text>
        </view>
        <view class="frow-meta">
          <text wx:if="{{item.start_at}}">时间：{{item.start_at}}</text>
          <text wx:if="{{item.location}}">　地点：{{item.location}}</text>
        </view>
        <view class="frow-meta">
          <text>已报名 {{item.enrolled_count}} 人</text>
          <text wx:if="{{item.capacity}}"> / 名额 {{item.capacity}}</text>
          <text wx:else>（不限人数）</text>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{!list.length}}">暂无三会一课安排</view>

    <view class="btn-row">
      <button class="btn ghost" bindtap="goActivities">查看全部活动报名</button>
    </view>
  </block>
</view>
