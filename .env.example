# ===== 智慧党建系统 环境配置模板 =====
# 用法：复制本文件为 .env，再按实际环境填写。
# 所有域名、端口、数据库地址、AppID、密钥只允许写在这里，不允许写进代码。

# ---------- 基础 ----------
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=5000
# 对外可访问地址（微信服务器回调、菜单链接都依赖它）。
# 本地测试可用内网穿透地址，学校部署时改成学校域名。
# 留空时系统会自动用当前请求的 host 拼接，避免写死。
PUBLIC_BASE_URL=
# 站点名称与党支部名称（第二阶段换成学校信息）
SITE_NAME=HXAI云 · 智慧党建
BRANCH_NAME=第一党支部
# 会话密钥：生产环境必须换成随机长字符串
SECRET_KEY=change-me-to-a-random-string

# ---------- 数据库 ----------
# sqlite 或 mysql；换 MySQL 只改这一段，代码不用动
DB_ENGINE=sqlite
SQLITE_PATH=data/dangjian.db
# 以下仅在 DB_ENGINE=mysql 时生效
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DB=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_CHARSET=utf8mb4

# ---------- 文件上传 ----------
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=20
ALLOWED_UPLOAD_EXT=doc,docx,pdf,xls,xlsx,ppt,pptx,txt,csv,md,jpg,jpeg,png

# ---------- 微信公众号（第一阶段：个人订阅号 HXAI云）----------
# 公众号后台「设置与开发 → 基本配置」里的 AppID / AppSecret
WECHAT_APPID=
WECHAT_APPSECRET=
# 服务器配置里的 Token（消息推送验签用，自定义字符串）
WECHAT_TOKEN=
# 若开启安全模式，填 EncodingAESKey；明文模式留空
WECHAT_AES_KEY=
# 登录方式：test=本地测试账号（默认）；wechat=微信网页授权（需认证服务号/已认证订阅号权限）
LOGIN_MODE=test
# 是否允许测试账号登录
ALLOW_TEST_LOGIN=true
# 是否在页面顶部显示"测试数据"标识
SHOW_DEMO_BADGE=true

# ---------- 管理员初始账号（首次初始化数据库时创建）----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
ADMIN_REAL_NAME=系统管理员
